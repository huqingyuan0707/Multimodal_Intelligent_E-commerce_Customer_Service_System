# 本地开发示例（绝不入库真实密钥，对齐 AGENTS.md 安全红线）
APP_NAME=multimodal-cs
ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-and-rotate-in-prod
VECTOR_DB_URL=http://localhost:6333
CORS_ORIGINS=[]
HF_ENDPOINT=https://hf-mirror.com

# 登录鉴权 —— 本节是本地演示专用，禁止原样上生产。
# 生产分家三件套：ENV=prod + SEED_ON_START/B2B_SEED_DEMO/KB_SEED_DEMO 全关（缺一即启动报错），
# 另配强 JWT_SECRET（≥32 位）；生产首个管理员走 scripts/create_admin.py 创建（ADMIN_PASSWORD 传口令）。
ACCESS_TOKEN_EXPIRE_SECONDS=28800
JWT_ALGORITHM=HS256
# 注意：改 PASSWORD_HASH_ITERATIONS 会让存量密码全部验不过，需同步重刷
PASSWORD_HASH_ITERATIONS=100000
PASSWORD_SALT_BYTES=16
ROLES_SEPARATOR=,
SEED_ON_START=true
SEED_TENANT=demo-tenant
SEED_USERNAME=admin
SEED_PASSWORD=admin123
SEED_ROLES=cs,kb,shop,stock,ops,admin,goods:read,goods:write,stock:read,stock:write,order:read,order:fulfill

# 大模型：本地 Ollama（先 ollama pull qwen2.5:0.5b，再 ollama serve）
# 生产/云端只需换 BASE_URL 与 API_KEY，业务代码不动（见 ADR-0001）
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_REF_CHARS=400
LLM_FALLBACK_TO_TEMPLATE=true

# 多模态 FR-1（执行步骤 A）：VLM/ASR/TTS 单出口，业务只读 Settings
# 真图链路：VLM_MODEL 切视觉模型即生效（ollama pull qwen3-vl:2b 后改名）；
# ASR 走 OpenAI 兼容 /audio/transcriptions（FunASR/SenseVoice 网关同协议），无网关自动 stub 降级
MEDIA_DIR=./data/media
IMAGE_MAX_COUNT=9
IMAGE_MAX_BYTES=10485760
VLM_ENABLED=true
VLM_BASE_URL=http://127.0.0.1:11434/v1
VLM_MODEL=qwen2.5:0.5b
VLM_API_KEY=ollama
VLM_TIMEOUT_SECONDS=120
VLM_MAX_TOKENS=512
VLM_THINK=false
VLM_MAX_EDGE=1280
VLM_JPEG_QUALITY=82
VLM_CONFIDENCE_THRESHOLD=0.6
ASR_ENABLED=true
# 网关：tools/asr-gateway（uvicorn main:app --port 8100），未启动自动 stub 降级
ASR_BASE_URL=http://127.0.0.1:8100/v1
ASR_MODEL=sensevoice-small
ASR_API_KEY=local
ASR_TIMEOUT_SECONDS=30
ASR_CONFIDENCE_THRESHOLD=0.6
VOICE_MAX_SECONDS=60
VOICE_MAX_BYTES=5242880
TTS_ENABLED=true
TTS_VOICE=晓晓

# 历史对话三层 FR-1.4（窗口轮数 + Token 预算 + 摘要/单条截断，中文 1.5 字/token 统一口径）
SESSION_HISTORY_ROUNDS=20
SESSION_TOKEN_BUDGET=8000
SESSION_SUMMARY_CHARS=600
SESSION_MSG_CHARS=800

# 跨会话记忆 FR-4（短期 Redis 24h 滑动 + 长期 PG 偏好；长期写入仅显式"记住"授权）
MEMORY_SHORT_TTL=86400
MEMORY_LONG_ENABLED=true

# B 端业务阈值（金额一律整数「分」；生产把 B2B_SEED_DEMO 置 false 关掉演示数据）
B2B_SEED_DEMO=true
STOCK_WARN_DEFAULT=10
REFUND_APPROVAL_LIMIT_CENTS=10000
# 物流单号校验（8~24 位字母数字，非法返回 1001）
TRACKING_NO_PATTERN=^[A-Za-z0-9]{8,24}$
# 快递公司白名单（JSON 数组，发货校验与公司列表同源；.env 改后重启生效）
LOGISTICS_COMPANIES=["顺丰","中通","圆通","韵达","申通","京东","邮政","德邦"]
